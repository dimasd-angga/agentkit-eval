{
  "name": "agentkit-eval-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "docs:build": "pnpm -F @agentkit-eval/docs build",
    "docs:dev": "pnpm -F @agentkit-eval/docs dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "format": "biome format --write .",
    "lint": "biome check ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
