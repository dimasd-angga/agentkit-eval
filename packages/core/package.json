{
  "name": "@agentkit-eval/core",
  "version": "0.0.1",
  "description": "Type-safe evals for AI agents. Score traces, not just outputs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --build"
  },
  "engines": {
    "node": ">=20"
  }
}
